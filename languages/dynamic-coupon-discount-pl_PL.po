msgid "Dynamic discount"
msgstr "Dynamiczne reguły rabatu"

msgid "Activate dynamic discount"
msgstr "Włącz dynamiczne reguły rabatu"

msgid "When active and at least one rule exists, the default coupon amount is ignored and only the rules below are used."
msgstr "Gdy opcja jest włączona i istnieje co najmniej jedna reguła, domyślna wartość kuponu jest ignorowana, a stosowane są wyłącznie poniższe reguły."

#. translators: %s: currency symbol
#, php-format
msgid "Rules are matched against the cart total (%s). Leave \"Price to\" empty for no upper limit. If ranges overlap, the first matching rule (lowest \"Price from\") wins. If no rule matches, the coupon cannot be applied."
msgstr "Reguły są dopasowywane do wartości koszyka (%s). Pozostaw pole „Cena do” puste, aby nie ustawiać górnego limitu. Jeśli zakresy się pokrywają, stosowana jest pierwsza pasująca reguła (o najniższej wartości „Cena od”). Jeśli żadna reguła nie pasuje, kupon nie zostanie użyty."

#, php-format
msgid "Price from (%s)"
msgstr "Cena od (%s)"

#, php-format
msgid "Price to (%s)"
msgstr "Cena do (%s)"

msgid "Discount"
msgstr "Rabat"

msgid "Type"
msgstr "Typ"

msgid "Percent (%)"
msgstr "Procent (%)"

#, php-format
msgid "Flat (%s)"
msgstr "Kwota (%s)"

msgid "Remove rule"
msgstr "Usuń regułę"

msgid "Add rule"
msgstr "Dodaj regułę"

msgid "This coupon is not available for the current cart total."
msgstr "Ten kupon nie jest dostępny dla bieżącej wartości koszyka."
